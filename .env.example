# Used only by operator tools. The public station receives none of these.
JELLYFIN_URL=http://jellyfin.private.example:8096
JELLYFIN_API_KEY=
# Use your numeric IDs when operating outside a typical Linux desktop account.
OPERATOR_UID=1000
OPERATOR_GID=1000
IMPORT_DIRECTORY=./imports
# Keep loopback when using a reverse proxy on the same host.
BIND_ADDRESS=127.0.0.1
PORT=8000
